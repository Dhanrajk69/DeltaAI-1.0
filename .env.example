# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ================= SECURITY & AUTHENTICATION SETTINGS =================

# SESSION_SECRET: Cryptographic key used to sign and verify ephemeral session tokens.
# If omitted, a high-entropy random key is generated automatically on server boot.
SESSION_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SESSION_SECRET"

# DELTA_LIVE_TRADING_ENABLED: Explicit server-side safety gate for live capital execution.
# Default is "false". When false, all incoming orders with mode="LIVE" are rejected with HTTP 403.
# Set to "true" ONLY when verified live exchange connectivity and credentials exist.
DELTA_LIVE_TRADING_ENABLED="false"

# DELTA_API_KEY: Delta Exchange India API Key for live execution (server-side only, never exposed to client).
DELTA_API_KEY=""

# DELTA_API_SECRET: Delta Exchange India API Secret for HMAC-SHA256 signing (server-side only, never exposed to client).
DELTA_API_SECRET=""

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for Google Sign-In (Google Identity Services).
# Set in Google Cloud Console Credentials -> OAuth 2.0 Client IDs -> Web application.
VITE_GOOGLE_CLIENT_ID=""

